# ─── Database (DbConfigSchema) ───────────────────────────────────────
database_host=news_db
database_port=5432
database_user=your_db_user
database_password=your_db_password
database_name=your_db_name

# ─── AI Client (AIClientConfigSchema) ────────────────────────────────
ai_api_key=your_ai_api_key
ai_base_url=https://api.openai.com/v1
ai_model=gpt-4o-mini
ai_timeout=300000
ai_max_retries=3

# ─── Telegram (TelegramConfigSchema) ────────────────────────────────
telegram_token=your_telegram_bot_token

# ─── Input (InputSchema) ────────────────────────────────────────────
# Valid categories: international, football, realmadrid, f1, ai, mlb, shenzhen, tabletennis
categories=international, football, realmadrid, f1, ai, mlb, shenzhen, tabletennis
# Comma-separated chat/channel IDs
channels=123456789, -1001234567890

# ─── Fetch Options (FetchOptionsSchema) ── Optional ─────────────────
# fetch_timeout=30000
fetch_max_decode_items=10
# fetch_user_agent=Mozilla/5.0

# ─── Read Options (ReadOptionsSchema) ── Optional ───────────────────
# read_timeout=30000
# read_user_agent=Mozilla/5.0
# read_max_body_chars=50000
# read_concurrency=5

# ─── Format Options (FormatNewsOptionsSchema) ───────────────────────
# Valid languages: English, Chinese, Spanish, French, German, Italian, Portuguese, Russian, Japanese, Korean
language=English

# ─── History Options (HistoryNewsOptionsSchema) ── Optional ─────────
# history_time_window_days=3

# ─── Send Options (SendNewsOptionsSchema) ── Optional ───────────────
# Valid parse modes: MarkdownV2, HTML, Markdown
send_parse_mode=MarkdownV2
send_chunk_size=4000

# ─── Truncate Options (TruncateNewsOptionsSchema) ── Optional ───────
# truncate_max_items_per_category=5

# ─── Recency Filter Options (FilterRecencyOptionsSchema) ────────────
filter_recency_td_hours=48

# ─── Debug ──────────────────────────────────────────────────────────
debug=false

# ─── Error Notification ─────────────────────────────────────────────
# Comma-separated channel IDs to send error reports to
error_channels=123456789

# ─── Cron Schedule (CronConfigSchema) ───────────────────────────────
# Standard 5-field cron expression
cron_expr=0 8,12,18,22 * * *
time_zone=UTC

# ─── DAG Execution (DagConfigSchema) ────────────────────────────────
# Timeout in milliseconds
dag_timeout=900000
